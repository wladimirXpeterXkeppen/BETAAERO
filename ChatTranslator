/* ==================== 翻訳API ==================== */
const transCache = new Map();
const inFlight = new Map();

async function translateText(text, tl) {
    const key = text + '|' + tl;
    if (transCache.has(key)) return transCache.get(key);
    if (inFlight.has(key)) return inFlight.get(key);

    const p = (async () => {
        const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=${tl}&dt=t&q=${encodeURIComponent(text)}`;
        const r = await fetch(url);
        const d = await r.json();
        const out = { text: d[0].map(x => x[0]).filter(Boolean).join(''), src: d[2] || 'unknown' };
        transCache.set(key, out);
        if (transCache.size > 800) transCache.delete(transCache.keys().next().value);
        return out;
    })().finally(() => inFlight.delete(key));

    inFlight.set(key, p);
    return p;
}

function pickTarget(text, mode) {
    if (mode !== 'auto') return mode;
    const hasJa = /[\u3040-\u309f\u30a0-\u30ff\u4e00-\u9faf]/.test(text);
    return hasJa ? 'en' : 'ja';
}
function detectLangLocal(text) {
    if (/[\u3040-\u309f\u30a0-\u30ff]/.test(text)) return 'ja';
    if (/[\u4e00-\u9faf]/.test(text)) return 'zh';
    if (/[\uac00-\ud7af]/.test(text)) return 'ko';
    if (/[\u0400-\u04ff]/.test(text)) return 'ru';
    if (/[\u0600-\u06ff]/.test(text)) return 'ar';
    if (/[\u0e00-\u0e7f]/.test(text)) return 'th';
    if (/[\u0900-\u097f]/.test(text)) return 'hi';
    return 'en';
}
function langName(c) { return LANG_NATIVE[c] || c; }
function escapeHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

/* ==================== システムメッセージ判定 ==================== */
const SYS_RE = new RegExp([
    'joined the game','left the game','has joined','has left',
    'logged in','logged out','connected','disconnected',
    '退出しました','参加しました','入室しました','退室しました',
    'ログインしました','ログアウトしました',
    'が退出','が参加','が入室','が退室','が入りました','が出ました',
    'ゲームに参加','ゲームから退出',
    '加入了游戏','离开了游戏','已加入','已退出','已离开',
    '加入游戏','离开游戏','进入游戏','退出游戏',
    '참가했습니다','퇴장했습니다','입장했습니다',
].join('|'), 'i');

function isSystemMessage(sender, text, full) {
    if (!CONFIG.skipSystemMessages) return false;
    if (!sender) return true;
    if (SYS_RE.test(text) || SYS_RE.test(full)) return true;
    return false;
}

/* ==================== チャット入力フック（送信翻訳） ==================== */
const ST = { IDLE: 0, CAPTURED: 1, SENDING: 2 };
let inputState = ST.IDLE;

function findChatInput() {
    const sels = ['input.input.active-input','input.input','input[placeholder="入力..."]','textarea'];
    for (const s of sels) {
        for (const el of document.querySelectorAll(s)) {
            if (el.offsetParent !== null || el === document.activeElement) return el;
        }
    }
    return null;
}

window.addEventListener('keydown', async (e) => {
    if (__disabled.v) return;
    if (e.key !== 'Enter') return;
    if (e.isComposing || e.keyCode === 229) return;
    const input = findChatInput();
    if (!input || e.target !== input) return;
    if (inputState !== ST.IDLE) { e.preventDefault(); e.stopImmediatePropagation(); return; }

    const original = (input.value || '').trim();
    if (!original) return;
    if (CONFIG.skipPrefixes.some(p => original.startsWith(p))) return;

    e.preventDefault(); e.stopImmediatePropagation();
    inputState = ST.CAPTURED;
    log('送信翻訳中:', original);

    let translated = original;
    try {
        const tl = pickTarget(original, CONFIG.inputMode);
        const r = await translateText(original, tl);
        translated = r.text.replace(/\n+/g, ' ').trim();
        log('送信翻訳結果:', translated, '(→', tl + ')');
    } catch(err) { console.error('[MineFun] 送信翻訳失敗:', err); }
    if (!translated) translated = original;

    input.value = translated;
    input.dispatchEvent(new Event('input', { bubbles: true }));

    inputState = ST.SENDING;
    const opts = { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true, cancelable: true };
    input.dispatchEvent(new KeyboardEvent('keydown', opts));
    input.dispatchEvent(new KeyboardEvent('keyup', opts));
    setTimeout(() => { inputState = ST.IDLE; }, 200);
}, true);

window.addEventListener('keyup', (e) => {
    if (__disabled.v) return;
    if (e.key !== 'Enter') return;
    if (e.isComposing || e.keyCode === 229) return;
    const input = findChatInput();
    if (!input || e.target !== input) return;
    if (inputState === ST.CAPTURED) { e.preventDefault(); e.stopImmediatePropagation(); }
}, true);

/* ==================== 受信メッセージ処理 ==================== */
let messageDataAttribute = null;
let observer = null;

function detectMessageAttribute() {
    try {
        const css = [...document.styleSheets].find(x => x?.href && x?.href.includes('assets/Game-'));
        if (!css) return false;
        const rules = [...css.cssRules];
        const m = rules.find(x => x?.selectorText && x?.selectorText.includes('.messages[data-v-'));
        if (!m) return false;
        const r = m.selectorText.match(/\.messages\[(data-v-[^\]]+)\]/);
        if (!r) return false;
        if (r[1] !== messageDataAttribute) {
            messageDataAttribute = r[1];
            log('メッセージ属性検出:', messageDataAttribute);
            startObserver();
        }
        return true;
    } catch(e) { return false; }
}

function extractOriginalText(el) {
    if (el.dataset.minefunOrig) return el.dataset.minefunOrig;
    const clone = el.cloneNode(true);
    clone.querySelectorAll('.minefun-inline-translation').forEach(n => n.remove());
    return String(clone.innerText || clone.textContent || '').replace(/\s+/g, ' ').trim();
}

function parseMessage(el) {
    if (!el) return null;
    const full = extractOriginalText(el);
    if (!full) return null;
    const colonIdx = full.indexOf(':');
    let sender = '', text = full;
    if (colonIdx >= 0 && colonIdx < 30) {
        sender = full.slice(0, colonIdx).replace(/^[⭐★\s]+/, '').trim();
        text = full.slice(colonIdx + 1).trim();
    }
    let hasRole = false;
    el.querySelectorAll('img').forEach(img => {
        const src = img.src || '';
        if (/Verify|Youtuber|Mod|Vanguard|Streamer/i.test(src) || img.classList.contains('icon-img')) hasRole = true;
    });
    return { sender, text, full, hasRole, el };
}

function isBadMessage(text) {
    if (text.length > 300) return true;
    if ((text.match(/\n/g) || []).length >= 3) return true;
    if (/(^|\n)[^\s:]{2,20}[ \t]*:[^\n]{1,200}\n[^\s:]{2,20}[ \t]*:/.test(text)) return true;
    return false;
}

function ensureInline(el, translated, srcLang) {
    el.querySelectorAll('.minefun-inline-translation').forEach(n => n.remove());
    if (!CONFIG.inlineEnabled || !translated) return;

    const wrap = document.createElement('div');
    wrap.className = 'minefun-inline-translation';
    wrap.style.cssText = `
        margin-top:3px;
        padding:2px 0 0 8px;
        border-left:2px solid ${CONFIG.inlineStyle.borderColor};
        color:${CONFIG.inlineStyle.textColor};
        font-size:${CONFIG.inlineStyle.fontSize};
        line-height:1.35;
        opacity:0.92;
        pointer-events:none;
    `;
    const tag = CONFIG.showLangTag && srcLang
        ? `<span style="display:inline-block;margin-right:5px;padding:0 4px;background:rgba(59,130,246,0.18);border:1px solid rgba(59,130,246,0.35);border-radius:3px;font-size:0.78em;font-weight:700;letter-spacing:0.4px;color:${CONFIG.inlineStyle.borderColor};vertical-align:middle;">${LANG_SHORT[srcLang] || srcLang.toUpperCase().slice(0,2)}</span>`
        : '';
    wrap.innerHTML = tag + escapeHtml(translated);
    el.appendChild(wrap);
}

async function processMessage(el) {
    if (!el || el.nodeType !== 1) return;

    // 処理済みでも、Vueの再描画でinlineが消えていたら復元
    if (el.dataset.minefunDone === 'true') {
        if (CONFIG.inlineEnabled && !el.querySelector('.minefun-inline-translation') && el.dataset.minefunTrans) {
            ensureInline(el, el.dataset.minefunTrans, el.dataset.minefunSrc);
        }
        return;
    }

    const p = parseMessage(el);
    if (!p) return;
    if (isBadMessage(p.text)) { el.dataset.minefunDone = 'true'; return; }
    if (isSystemMessage(p.sender, p.text, p.full)) {
        el.dataset.minefunDone = 'true';
        return;
    }

    el.dataset.minefunOrig = p.text;

    const targetLang = pickTarget(p.text, CONFIG.receiveMode);
    const detected = detectLangLocal(p.text);
    const sender = (p.hasRole ? '⭐' : '') + p.sender;

    if (detected === targetLang) {
        el.dataset.minefunDone = 'true';
        if (CONFIG.boardEnabled) addToBoard(sender, p.text, p.text, langName(detected), true);
        return;
    }

    el.dataset.minefunDone = 'processing';

    try {
        const r = await translateText(p.text, targetLang);
        if (!r.text || !r.text.trim()) { el.dataset.minefunDone = 'true'; return; }

        el.dataset.minefunTrans = r.text;
        el.dataset.minefunSrc = r.src;
        el.dataset.minefunDone = 'true';

        ensureInline(el, r.text, r.src);
        if (CONFIG.boardEnabled) addToBoard(sender, p.text, r.text, langName(r.src), r.src === targetLang);
    } catch(err) {
        el.dataset.minefunDone = 'true';
        console.error('[MineFun] 受信翻訳失敗:', err);
    }
}

function startObserver() {
    if (observer) observer.disconnect();
    if (!document.body) { setTimeout(startObserver, 500); return; }

    observer = new MutationObserver((mutations) => {
        mutations.forEach(m => {
            m.addedNodes.forEach(node => {
                if (node.nodeType !== 1 || !messageDataAttribute) return;
                if (node.hasAttribute && node.hasAttribute(messageDataAttribute)) processMessage(node);
                if (node.querySelectorAll) {
                    node.querySelectorAll(`.messages[${messageDataAttribute}]`).forEach(processMessage);
                }
            });
        });
    });
    observer.observe(document.body, { childList: true, subtree: true });
    log('Observer開始');

    document.querySelectorAll(`.messages[${messageDataAttribute}]`).forEach(processMessage);
}

/* ==================== 翻訳ボード ==================== */
const boardData = [];

function addToBoard(sender, original, translated, langNameStr, isSameLang) {
    boardData.push({ sender, original, translated, langName: langNameStr, isSameLang, time: Date.now() });
    while (boardData.length > CONFIG.historyMax) boardData.shift();
    renderBoardItem(boardData[boardData.length - 1]);
}

function buildItemHTML(item) {
    const senderHTML = item.sender ? `<div style="color:#7ec8e3;font-size:11px;font-weight:bold;margin-bottom:3px;">${escapeHtml(item.sender)}</div>` : '';
    const langTag = (CONFIG.showLangTag && item.langName) ? `<span style="color:#aaa;font-size:10px;">[${escapeHtml(item.langName)}]</span> ` : '';
    if (item.isSameLang) return senderHTML + `<div style="color:#ccc;font-size:12px;">${langTag}${escapeHtml(item.original)}</div>`;
    const origHTML = CONFIG.showOriginalOnBoard ? `<div style="color:#888;font-size:11px;margin-bottom:2px;">${escapeHtml(item.original)}</div>` : '';
    return senderHTML + origHTML + `<div style="color:#fff;font-size:12px;">${langTag}${escapeHtml(item.translated)}</div>`;
}

function renderBoardItem(item) {
    const list = document.getElementById('minefun-board-list');
    if (!list) return;
    const div = document.createElement('div');
    div.style.cssText = 'border-bottom:1px solid #2a2a2a;padding:6px;';
    div.innerHTML = buildItemHTML(item);
    list.appendChild(div);
    while (list.children.length > CONFIG.historyMax) list.removeChild(list.firstChild);
    list.scrollTop = list.scrollHeight;
}

function renderBoardAll() {
    const list = document.getElementById('minefun-board-list');
    if (!list) return;
    list.innerHTML = '';
    boardData.forEach(item => {
        const div = document.createElement('div');
        div.style.cssText = 'border-bottom:1px solid #2a2a2a;padding:6px;';
        div.innerHTML = buildItemHTML(item);
        list.appendChild(div);
    });
    list.scrollTop = list.scrollHeight;
}

async function retranslateAll() {
    log('再翻訳中...');
    const msgNodes = messageDataAttribute
        ? [...document.querySelectorAll(`.messages[${messageDataAttribute}]`)]
        : [];

    // インライン再処理
    for (const el of msgNodes) {
        const p = parseMessage(el);
        if (!p || !p.text) continue;
        if (isSystemMessage(p.sender, p.text, p.full)) continue;

        const targetLang = pickTarget(p.text, CONFIG.receiveMode);
        const detected = detectLangLocal(p.text);

        if (detected === targetLang) {
            el.querySelectorAll('.minefun-inline-translation').forEach(n => n.remove());
            el.dataset.minefunDone = 'true';
            el.dataset.minefunTrans = '';
            el.dataset.minefunSrc = detected;
            continue;
        }
        try {
            const r = await translateText(p.text, targetLang);
            if (r.text && r.text.trim()) {
                el.dataset.minefunTrans = r.text;
                el.dataset.minefunSrc = r.src;
                el.dataset.minefunDone = 'true';
                ensureInline(el, r.text, r.src);
            }
        } catch(e) {}
    }

    // ボード再構築
    boardData.length = 0;
    const list = document.getElementById('minefun-board-list');
    if (list) list.innerHTML = '';

    for (const el of msgNodes) {
        const p = parseMessage(el);
        if (!p || !p.text) continue;
        if (isSystemMessage(p.sender, p.text, p.full)) continue;

        const sender = (p.hasRole ? '⭐' : '') + p.sender;
        const detected = detectLangLocal(p.text);
        const targetLang = pickTarget(p.text, CONFIG.receiveMode);

        if (detected === targetLang) {
            addToBoard(sender, p.text, p.text, langName(detected), true);
        } else if (el.dataset.minefunTrans) {
            addToBoard(sender, p.text, el.dataset.minefunTrans, langName(el.dataset.minefunSrc), false);
        }
    }
    log('再翻訳完了');
}


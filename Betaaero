      'chuuni':    'Style: chuunibyou dramatic. Japanese: 「我が名は…」のような厨二口調.',
      'butler':    'Style: butler tone. Japanese: 「〜でございます」「お嬢様/旦那様」.',
      'kansai':    'Style: Kansai dialect. Japanese: 関西弁 (「〜やで」「〜やんか」).',
      'kyoto':     'Style: Kyoto dialect. Japanese: 京都弁 (「〜どす」).',
      'tohoku':    'Style: Tohoku dialect. Japanese: 東北弁 (「〜だべ」「〜っちゃ」).',
      'cat':       'Style: Add "nya" at the end. Japanese: 「〜にゃ」「〜にゃん」.',
      'robot':     'Style: robot tone. Japanese: 「〜デス」「〜マス」カタカナ多め.',
      'pirate':    'Style: pirate. Japanese: 海賊口調.',
      'yakuza':    'Style: yakuza. Japanese: 「〜やぞ」「〜やないか」.'
    };

    const DEFAULT_PROMPTS = {
      system:
        'You are a translator for MineFun.io (BedWars, SkyWars, The War). ' +
        'Translate the message into {{targetLang}}. ' +
        'Rules: 1) Use recent chat context to resolve pronouns/slang. ' +
        '2) Preserve original tone. ' +
        '3) Keep gaming acronyms as-is: gg, wp, ez, gl, hf, noob, clutch, op. ' +
        '4) Do NOT translate usernames/numbers. ' +
        '5) Output ONLY the translated text. ' +
        '{{extraStyle}}',
      user: '{{context}}Translate this message:\n{{text}}'
    };

    /* ---- Context buffer ---- */
    const ctxBuffer = [];
    const CTX_MAX = 20;

    function addToContext(sender, text) {
      ctxBuffer.push({ sender: sender, text: text, at: Date.now() });
      while (ctxBuffer.length > CTX_MAX) ctxBuffer.shift();
    }
    function buildContext() {
      const n = cfg('contextSize', 5);
      if (!n || ctxBuffer.length === 0) return '';
      return ctxBuffer.slice(-n).map(function (m) {
        return m.sender + ': ' + m.text;
      }).join('\n');
    }
    function buildSystemPrompt(tl, direction) {
      direction = direction || 'receive';
      const tpl = cfg('customPromptEnabled', false)
        ? cfg('systemPrompt', DEFAULT_PROMPTS.system)
        : DEFAULT_PROMPTS.system;

      const presetKey = direction === 'send' ? 'sendStylePreset' : 'stylePreset';
      const extraKey  = direction === 'send' ? 'sendExtraStyle'  : 'extraStyle';

      const preset = cfg(presetKey, 'default');
      let style = STYLE_PRESETS[preset] || '';
      const extra = cfg(extraKey, '');
      if (extra) style = style ? style + '\n' + extra : extra;

      return tpl
        .replace(/\{\{targetLang\}\}/g, LANG_NAMES[tl] || tl)
        .replace(/\{\{extraStyle\}\}/g, style);
    }
    function buildUserPrompt(text) {
      const tpl = cfg('customPromptEnabled', false)
        ? cfg('userPrompt', DEFAULT_PROMPTS.user)
        : DEFAULT_PROMPTS.user;
      const ctx = buildContext();
      const contextBlock = ctx ? 'Recent chat:\n' + ctx + '\n\n' : '';
      return tpl
        .replace(/\{\{context\}\}/g, contextBlock)
        .replace(/\{\{text\}\}/g, text);
    }
    /* ---- Language tables ---- */
    const LANGS = [
      { value: 'auto',  label: 'Auto (JA->EN / others->JA)' },
      { value: 'en',    label: 'English' },
      { value: 'ja',    label: 'Japanese' },
      { value: 'zh',    label: 'Chinese (Simplified)' },
      { value: 'zh-tw', label: 'Chinese (Traditional)' },
      { value: 'ko',    label: 'Korean' },
      { value: 'es',    label: 'Spanish' },
      { value: 'fr',    label: 'French' },
      { value: 'de',    label: 'German' },
      { value: 'pt',    label: 'Portuguese' },

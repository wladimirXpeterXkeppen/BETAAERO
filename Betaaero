/* ===== MOD: FPS Booster ===== */
  Mods.reg({
    id: 'fpsbooster', name: 'FPS Booster', category: 'Performance', icon: 'svg:lightning', description: 'WebGL/Effects/Timer optimization', defaultEnabled: false,
    settings: [
      { id: 'fpsMode', type: 'dropdown', label: 'Mode', options: [{ value: 'adaptive', label: 'Adaptive' }, { value: 'balanced', label: 'Balanced' }, { value: 'performance', label: 'Performance' }, { value: 'ultra', label: 'Ultra' }], default: 'performance' },
      { id: 'webgl', type: 'dropdown', label: 'WebGL', options: [{ value: 0, label: 'OFF' }, { value: 1, label: 'LIGHT' }, { value: 2, label: 'MEDIUM' }, { value: 3, label: 'STRONG' }], default: 2 },
      { id: 'effects', type: 'dropdown', label: 'Effects', options: [{ value: 0, label: 'OFF' }, { value: 1, label: 'LIGHT' }, { value: 2, label: 'MEDIUM' }, { value: 3, label: 'STRONG' }], default: 2 },
      { id: 'timerGuard', type: 'dropdown', label: 'Timer guard', options: [{ value: 0, label: 'OFF' }, { value: 1, label: 'LIGHT' }, { value: 2, label: 'MEDIUM' }, { value: 3, label: 'STRONG' }], default: 0 },
      { id: 'consoleMute', type: 'toggle', label: 'Console mute', default: false },
      { id: 'cameraEnabled', type: 'toggle', label: 'Camera far', default: true },
      { id: 'cameraFar', type: 'slider', label: 'Camera distance', min: 5, max: 150, step: 1, default: 40 }
    ],
    init() {
      const st = this;
      st._origGC = HTMLCanvasElement.prototype.getContext;
      st._origSI = window.setInterval;
      st._origConsole = { log: console.log, warn: console.warn, error: console.error, info: console.info, debug: console.debug };
      st._pW = false; st._pT = false; st._pC = false;
      st._samples = []; st._frames = 0; st._last = performance.now();
      st._cfg = null;
      st._refreshCfg = () => { st._cfg = Config.get('mods.fpsbooster') || {}; };
      st._refreshCfg();
      st._webgl = l => {
        l = clamp(l | 0, 0, 3);
        if (l > 0 && !st._pW) {
          const o = st._origGC;
          HTMLCanvasElement.prototype.getContext = function(t, a) {
            if (t === 'webgl' || t === 'webgl2') {
              a = Object.assign({}, a || {});
              if (l >= 1) a.antialias = false;
              if (l >= 2) a.powerPreference = 'high-performance';
              if (l >= 3) a.preserveDrawingBuffer = false;
            }
            return o.call(this, t, a);
          };
          st._pW = true;
        } else if (l === 0 && st._pW) { HTMLCanvasElement.prototype.getContext = st._origGC; st._pW = false; }
      };
      st._effects = l => {
        l = clamp(l | 0, 0, 3);
        const el = document.documentElement;
        el.classList.remove('ac-fx-1', 'ac-fx-2', 'ac-fx-3');
        if (l) el.classList.add('ac-fx-' + l);
      };
      st._timer = l => {
        l = clamp(l | 0, 0, 3);
        if (l > 0 && !st._pT) {
          const o = st._origSI;
          window.setInterval = function(f, d) {
            const n = Number(d) || 0;
            const mn = l === 1 ? 50 : l === 2 ? 100 : 250;
            return o.call(this, f, Math.max(mn, n));
          };
          st._pT = true;
        } else if (l === 0 && st._pT) { window.setInterval = st._origSI; st._pT = false; }
      };
      st._console = on => {
        if (on && !st._pC) {
          const n = () => {};
          console.log = console.warn = console.error = console.info = console.debug = n;
          st._pC = true;
        } else if (!on && st._pC) { Object.assign(console, st._origConsole); st._pC = false; }
      };
      st._setCameraFar = value => {
        const gw = Game.world(); if (!gw) return false;
        const cl = Math.max(5, Math.min(200, value));
        let ch = false;
        if (gw.threeScene && gw.threeScene.foregrCamera) {
          const cam = gw.threeScene.foregrCamera;
          if (cam.far !== cl) { cam.far = cl; if (cam.updateProjectionMatrix) cam.updateProjectionMatrix(); ch = true; }
        }
        if (gw.threeScene && gw.threeScene.camera && gw.threeScene.camera !== gw.threeScene.foregrCamera) {
          const bg = gw.threeScene.camera;
          const bgc = Math.max(10, cl * 1.5);
          if (bg.far !== bgc) { bg.far = bgc; if (bg.updateProjectionMatrix) bg.updateProjectionMatrix(); ch = true; }
        }
        return ch;
      };
      st._adaptiveRaf = 0; st._adaptiveRunning = false;
      const adaptiveLoop = now => {
        const s = st._cfg;
        if (!Mods.on('fpsbooster') || !s || s.fpsMode !== 'adaptive') { st._adaptiveRaf = 0; st._adaptiveRunning = false; return; }
        st._adaptiveRaf = requestAnimationFrame(adaptiveLoop);
        const dt = now - st._last;
        st._last = now;
        st._frames++;
        if (dt > 0 && dt < 1000) {
          st._samples.push(1000 / dt);
          if (st._samples.length > 30) st._samples.shift();
        }
        if (st._samples.length >= 10) {
          const fps = st._samples.reduce((a, b) => a + b, 0) / st._samples.length;
          let level = 0;
          if (fps < 43) level = 3;
          else if (fps < 50) level = 2;
          else if (fps < 56) level = 1;
          const cur = s.webgl || 0;
          if (level !== cur) {
            Mods.ss('fpsbooster', 'webgl', level);
            Mods.ss('fpsbooster', 'effects', Math.min(level, 3));

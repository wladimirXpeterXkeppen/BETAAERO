          if (d < by) { by = d; sy = ny + (p[1] - p[0]); lines = lines.filter(x => x.t !== 'h'); lines.push({ t: 'h', p: p[1] }); }
        });
      });
      return lines.length ? { x: sx, y: sy, l: lines } : null;
    }
    function _updateBar(cx, cy) {
      if (!_barEl || !document.body.contains(_barEl)) return;
      const W = _barEl.offsetWidth || 400;
      const H = _barEl.offsetHeight || 48;
      const left = (innerWidth - W) / 2;
      const right = left + W;
      const top = 18;
      const bottom = top + H;
      const mx = 80, my = 80;
      const inX = cx >= left - mx && cx <= right + mx;
      const inY = cy < bottom + my;
      const overExpanded = cx >= left && cx <= right && cy >= top && cy <= bottom;
      const overPeek = cx >= left && cx <= right && cy <= 16;
      let shouldPeek;
      if (drag) shouldPeek = true;
      else if (inX && inY) shouldPeek = !overExpanded && !overPeek;
      else shouldPeek = false;
      if (shouldPeek !== _barPeek) { _barPeek = shouldPeek; _barEl.classList.toggle('ac-editor-bar-peek', shouldPeek); }
    }
    function down(ev) {
      ev.preventDefault(); ev.stopPropagation();
      const id = this.dataset.hudId;
      if (!id) return;
      if (!ev.shiftKey) sel.clear();
      sel.add(id);
      draw(null);
      drag = { id, sx: ev.clientX, sy: ev.clientY, m: new Map() };
      sel.forEach(s => { const c = HUD.get(s).getConf(); drag.m.set(s, { x: c.x, y: c.y }); });
      if (_barEl && !_barPeek) { _barPeek = true; _barEl.classList.add('ac-editor-bar-peek'); }
    }
    function move(ev) {
      if (!drag) return;
      const dx = ev.clientX - drag.sx, dy = ev.clientY - drag.sy;
      const mo = drag.m.get(drag.id);
      let nx = mo.x + dx, ny = mo.y + dy;
      const s = snapCalc(drag.id, nx, ny);
      if (s) { nx = s.x; ny = s.y; }
      HUD.setPos(drag.id, nx, ny);
      const mx = nx - mo.x, my = ny - mo.y;
      sel.forEach(sid => {
        if (sid === drag.id) return;
        const o = drag.m.get(sid);
        if (!o) return;
        HUD.setPos(sid, o.x + mx, o.y + my);
      });
      draw(s ? s.l : null);
    }
    function up() { if (drag) { drag = null; draw(null); } }
    function key(e) {
      if (e.code === 'Escape') { close(); return; }
      if (e.code === 'Delete' || e.code === 'Backspace') {
        if (!sel.size) return;
        e.preventDefault();
        sel.forEach(id => { HUD.resetPos(id); });
        draw(null);
        return;
      }
      if (sel.size && (e.code === 'ArrowUp' || e.code === 'ArrowDown' || e.code === 'ArrowLeft' || e.code === 'ArrowRight')) {
        e.preventDefault();
        e.stopPropagation();
        const step = e.shiftKey ? 10 : 1;
        let dx = 0, dy = 0;
        if (e.code === 'ArrowUp')    dy = -step;
        else if (e.code === 'ArrowDown')  dy =  step;
        else if (e.code === 'ArrowLeft')  dx = -step;
        else if (e.code === 'ArrowRight') dx =  step;
        sel.forEach(id => {
          const entry = HUD.get(id);
          if (!entry) return;
          const c = entry.getConf();
          HUD.setPos(id, c.x + dx, c.y + dy);
        });
        draw(null);
      }
    }
    function killOrphanDom() {
      try { document.querySelectorAll('#ac-editor').forEach(x => { if (x !== eov) { try { x.remove(); } catch (_) {} } }); } catch (_) {}
    }
    function open_() {
      if (eopen) {
        if (eov && document.body.contains(eov)) return;
        try { close(); } catch (_) { eopen = false; eov = null; sel.clear(); drag = null; }
      }
      killOrphanDom();
      eopen = true;
      PointerLock.release();
      document.body.classList.add('ac-editing');
      eov = ce('div'); eov.id = 'ac-editor';
      document.body.appendChild(eov);
      const bar = ce('div', 'ac-editor-bar', eov);
      _barEl = bar; _barPeek = false;
      _onBarMove = e => _updateBar(e.clientX, e.clientY);
      window.addEventListener('mousemove', _onBarMove);
      const btn = (tt, f) => { const b = ce('button', '', bar); b.textContent = tt; b.onclick = f; return b; };
      const sb = btn(snap ? '⊞ Snap ON' : '⊞ Snap OFF', () => { snap = !snap; sb.textContent = snap ? '⊞ Snap ON' : '⊞ Snap OFF'; });
      bar.appendChild(sep());
      const done = ce('button', 'ac-editor-done', bar);
      done.textContent = '✔ Done';
      done.onclick = e => { e.preventDefault(); e.stopPropagation(); close(); };
      const hint = ce('div', 'ac-editor-hint', eov);
      hint.innerHTML = '<b>Drag</b> to move · <b>Arrows</b> nudge (1px, Shift=10px) · <b>Shift+Click</b> multi-select · <b>Del</b> resets selected';
      gc = ce('canvas', '', eov);
      resize();
      HUD.list().forEach(e => { e.el.style.pointerEvents = 'auto'; e.el.style.cursor = 'move'; e.el.onmousedown = down; });
      fi = setInterval(() => {
        if (!document.body.classList.contains('ac-editing')) { clearInterval(fi); fi = null; return; }
        HUD.list().forEach(e => {
          if (e.el.style.display === 'none') e.el.style.display = 'block';
          e.el.style.pointerEvents = 'auto';
          if (e.opts && e.opts.update) { try { e.opts.update(e.el); } catch (_) {} }
        });
      }, 100);
      window.addEventListener('resize', resize);
      window.addEventListener('mousemove', move);
      window.addEventListener('mouseup', up);
      window.addEventListener('keydown', key);
    }
    function close() {
      const wasOpen = eopen;
      try {
        eopen = false; sel.clear(); drag = null;
        document.body.classList.remove('ac-editing');
        if (fi) { clearInterval(fi); fi = null; }
        if (_onBarMove) { window.removeEventListener('mousemove', _onBarMove); _onBarMove = null; }
        _barEl = null; _barPeek = false;
        HUD.list().forEach(e => {
          try { e.el.style.pointerEvents = 'none'; e.el.style.cursor = ''; e.el.onmousedown = null; HUD.sync(e.id); } catch (_) {}
        });
        window.removeEventListener('resize', resize);
        window.removeEventListener('mousemove', move);
        window.removeEventListener('mouseup', up);
        window.removeEventListener('keydown', key);
      } catch (e) { eopen = false; sel.clear(); drag = null; }
      try { if (eov) eov.remove(); } catch (_) {}
      eov = null; gc = null;
      killOrphanDom();
      try { Config.flush(); } catch (_) {}
      if (wasOpen) { try { PointerLock.fixCanvas(); PointerLock.acquire(); } catch (_) {} }
    }
    return { open: open_, close, isOpen: () => eopen, isAlive: () => !!(eopen && eov && document.body.contains(eov)) };
  })();

  /* ============================================================
     Stats Inline Fix (v32.2) — keep FPS/CPS/PING on one line
     Surgical: only touches the counters, .stats, .stats children,
     and .stats's parent overflow. Inline !important beats any
     external stylesheet rule.
     ============================================================ */
  const StatsInline = (() => {
    const SEL = '.ac-hud-fps,.ac-hud-cps,.ac-hud-ping';
    const forced = new Map();

    function force(el, styles) {
      if (!el || el.nodeType !== 1) return;
      if (!forced.has(el)) {
        const snap = {};
        for (const k in styles) snap[k] = [el.style.getPropertyValue(k), el.style.getPropertyPriority(k)];
        forced.set(el, snap);
      }
      for (const k in styles) el.style.setProperty(k, styles[k], 'important');
    }

    function restore() {
      for (const [el, snap] of Array.from(forced.entries())) {
        if (!el || !el.isConnected) { forced.delete(el); continue; }
        for (const k in snap) {
          const [v, p] = snap[k];
          if (v) el.style.setProperty(k, v, p || '');
          else   el.style.removeProperty(k);
        }
        forced.delete(el);
      }
    }

    const COUNTER = { 'display': 'inline-flex', 'flex-shrink': '0', 'white-space': 'nowrap', 'vertical-align': 'middle' };
    const STATS   = { 'display': 'flex', 'flex-wrap': 'nowrap', 'width': 'max-content', 'max-width': 'none', 'overflow': 'visible' };
    const CHILD   = { 'flex-shrink': '0', 'white-space': 'nowrap' };
    const PARENT  = { 'overflow': 'visible', 'overflow-x': 'visible', 'overflow-y': 'visible' };

    function apply() {
      const counters = document.querySelectorAll(SEL);
      if (!counters.length) return;
      counters.forEach(el => {
        force(el, COUNTER);
        let stats = el.parentElement;
        while (stats && stats !== document.body) {
          if (stats.classList && stats.classList.contains('stats')) break;
          stats = stats.parentElement;
        }
        if (!stats || stats === document.body) return;
        force(stats, STATS);
        const kids = stats.children;
        for (let i = 0; i < kids.length; i++) force(kids[i], CHILD);
        const par = stats.parentElement;
        if (par && par !== document.body) force(par, PARENT);
      });
    }

    let domObs = null, styleObs = null, intId = 0, resizeObs = null;
    function start() {
      if (!domObs) {
        domObs = new MutationObserver(() => apply());
        domObs.observe(document.body, { childList: true, subtree: true });
      }
      if (!styleObs) {
        styleObs = new MutationObserver(muts => {
          for (let i = 0; i < muts.length; i++) {
            const el = muts[i].target;
            if (el.classList && (el.classList.contains('ac-hud-fps') || el.classList.contains('ac-hud-cps') || el.classList.contains('ac-hud-ping'))) {
              apply(); return;
            }
          }
        });
        styleObs.observe(document.body, { attributes: true, attributeFilter: ['style'], subtree: true });
      }
      if (!resizeObs && typeof ResizeObserver !== 'undefined') {
        resizeObs = new ResizeObserver(() => apply());
        resizeObs.observe(document.documentElement);
      }
      if (!intId) intId = setInterval(apply, 500);
      apply();
    }
    function stop() {
      if (domObs)    { try { domObs.disconnect();    } catch (_) {} domObs = null; }
      if (styleObs)  { try { styleObs.disconnect();  } catch (_) {} styleObs = null; }
      if (resizeObs) { try { resizeObs.disconnect(); } catch (_) {} resizeObs = null; }
      if (intId) { clearInterval(intId); intId = 0; }
      restore();
    }
    return { start, stop, apply, restore, _forced: forced };
  })();

  /* ===== Detection ===== */
  setInterval(() => {
    const w = Game.world();
    const homeEl = document.querySelector('.home');
    let hv = false;
    if (homeEl) {
      const r = homeEl.getBoundingClientRect();
      const cs = getComputedStyle(homeEl);
      hv = (r.width > 0 && r.height > 0 && cs.display !== 'none' && cs.visibility !== 'hidden');
    }
    const ig = !!(w && w.player && !hv);
    const wIG = document.body.classList.contains('ac-not-in-game') === false;
    if (wIG !== ig) document.body.classList.toggle('ac-not-in-game', !ig);
    let ha = false;
    if (w && w.player && w.player.armor) {
      try {
        const arr = Array.from(w.player.armor);
        ha = arr.some(v => {
          if (v == null) return false;
          if (Array.isArray(v)) return Number(v[0]) > 0;
          if (typeof v === 'object') return Number(v.id || v.itemId || v.itemID || v.type || 0) > 0;
          return Number(v) > 0;
        });
      } catch (_) {}
    }
    const wHA = document.body.classList.contains('ac-no-armor') === false;
    if (wHA !== ha) document.body.classList.toggle('ac-no-armor', !ha);
  }, 600);

  /* ===== Boot ===== */
  Config.load();
  Mods.boot();

  // Stats Inline Fix — start once DOM is ready
  if (document.body) StatsInline.start();
  else document.addEventListener('DOMContentLoaded', () => StatsInline.start(), { once: true });

  // v32.5: wait for the MineFun game world to be available before loading
  // plugins. Plugins often touch Game.world() / DOM in init(), and the
  // previous 50ms delay was too short on slow machines, causing
  // intermittent "plugin didn't load" symptoms.
  function waitForWorldReady(maxMs) {
    return new Promise(resolve => {
      const t0 = performance.now();
      const check = () => {
        if (Game.world() || performance.now() - t0 > maxMs) return resolve();
        setTimeout(check, 150);
      };
      check();
    });
  }

  (async () => {
    try {
      await new Promise(r => setTimeout(r, 200));
      await waitForWorldReady(15000);
      const rs = await Plugins.runAll();
      rs.forEach(r => { if (!r.ok) console.warn('[Plugin] load failed:', r.id, r.error); });
      if (rs.length) console.log('[AeroClient] Plugins loaded:', rs.length);
    } catch (e) { console.warn('[Plugin] boot error', e); }
  })();
  const MAX_HOLD = 350;
  let modCode = null, modDownAt = 0, comboUsed = false;
  const MODS_SET = new Set(['ShiftLeft', 'ShiftRight', 'ControlLeft', 'ControlRight', 'AltLeft', 'AltRight', 'MetaLeft', 'MetaRight']);

  window.addEventListener('keydown', e => {
    if (!e.code || e.repeat) return;
    if (MODS_SET.has(e.code)) {
      if (!modCode) { modCode = e.code; modDownAt = Date.now(); comboUsed = false; }
      else comboUsed = true;
      return;
    }
    if (modCode) comboUsed = true;
  }, true);

  window.addEventListener('keyup', e => {
    if (!e.code) return;
    if (e.code !== 'ShiftRight') {
      if (e.code === modCode) { modCode = null; modDownAt = 0; comboUsed = false; }
      return;
    }
    const held = Date.now() - modDownAt;
    const fire = e.code === 'ShiftRight' && held < MAX_HOLD && !comboUsed;
    modCode = null; modDownAt = 0; comboUsed = false;
    if (fire) { if (isText()) return; GUI.toggle(); }
  }, true);

  window.addEventListener('keydown', e => {
    if (e.repeat) return;
    if (e.code === 'F8' && !isText()) { if (open) close_(); else open_(); }
  }, true);

  document.addEventListener('keydown', e => { if (e.repeat) return; Input._down(e.code); }, true);
  document.addEventListener('keyup', e => Input._up(e.code), true);
  document.addEventListener('mousedown', e => { Input._down('Mouse' + e.button); Input._clk(e.button); }, true);
  document.addEventListener('mouseup', e => { Input._up('Mouse' + e.button); }, true);

  window.AeroClient = {
    version: '32.4.0-beta',
    Config, Mods, HUD, GUI, Editor, Reach, Game, Physics, PointerLock, PixelEditor, IDB, PDB, Confirm, Plugins, ICONS,
    StatsInline,
    open: () => GUI.open(),
    close: () => GUI.close(),
    toggle: () => { if (open) close_(); else open_(); },
    forceOpen: () => GUI.open(),
    _d() {
      try { StatsInline.stop(); } catch (_) {}
      Mods.killAll();
      try { if (Editor && Editor.isOpen && Editor.isOpen()) Editor.close(); } catch (_) {}
      ['ac-hud-root', 'ac-style', 'ac-theme-aero', 'ac-theme-moon', 'ac-theme-tno', 'ac-editor', 'ac-cleanui', 'ac-crosshair', 'ac-hitbox-canvas', 'ac-blockoutline-canvas', 'ac-atmo-css', 'ac-shot-style', 'ac-shot-xh', 'ac-rec-style', 'ac-invcustomizer'].forEach(id => document.getElementById(id)?.remove());
      const ovl = document.querySelector('.ac-overlay');
      if (ovl) ovl.remove();
      document.querySelectorAll('.ac-modal-mask').forEach(m => m.remove());
      document.documentElement.classList.remove('ac-fx-1', 'ac-fx-2', 'ac-fx-3');
      if (window.__acPingHooked) window.__acPingHooked = false;
      delete window.AeroClient;
      console.log('%c[AeroClient] Destroyed', 'color:#ff8899;');
    }
  };

  console.log('%c✦ AeroClient v32.4.0 BETA', 'color:#93c5fd;font-weight:bold;font-size:13px;background:#0f0f11;padding:4px 8px;border-radius:4px');
  console.log('  Start: R-Shift / F8');
  console.log('  Mods:', Mods.all().length);
  console.log('  + Canvas Resize Fix built into core');
  console.log('  + Screenshot: HUD restore bug fixed (MP3 / Compass)');
  console.log('  + Keybind: Debug entry removed');
  console.log('  Storage: ac.cfg.v29 (+ .bak) / ac-plugins-db / ac-db');
})();

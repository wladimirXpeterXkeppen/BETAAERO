      el._h = setTimeout(function () { el.style.opacity = '0'; }, 1800);
    }

    /* ---- Translation API ---- */
        const transCache = new Map();
    const inFlight = new Map();

    async function _trGoogle(text, tl) {
      const url = 'https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=' + tl + '&dt=t&q=' + encodeURIComponent(text);
      const r = await fetch(url);
      if (!r.ok) throw new Error('Google ' + r.status);
      const d = await r.json();
      return {
        text: (d[0] || []).map(function (x) { return x[0]; }).filter(Boolean).join(''),
        src: d[2] || 'unknown',
        provider: 'google'
      };
    }

    async function _trProxy(text, tl, direction) {
      const base = cfg('proxyURL', '');
      if (!base) throw new Error('Worker URL not set');
      const r = await fetch(base.replace(/\/$/, '') + '/translate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          messages: [
            { role: 'system', content: buildSystemPrompt(tl, direction) },
            { role: 'user',   content: buildUserPrompt(text) }
          ],
          targetLang: LANG_NAMES[tl] || tl
        })
      });
      if (!r.ok) {
        const e = await r.json().catch(function () { return {}; });
        throw new Error('Proxy ' + r.status + ': ' + (e.error || 'unknown'));
      }
      const d = await r.json();
      const c = d.choices && d.choices[0] && d.choices[0].message ? d.choices[0].message.content : '';
      return {
        text: String(c).trim().replace(/^["'「『]+|["'」』]+$/g, '').trim(),
        src: detectLangLocal(text),
        provider: 'proxy'
      };
    }

    async function _trSimply(text, tl) {
      const r = await fetch('https://api.simplytranslate.ai/translate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: text, from: 'auto', to: tl })
      });
      if (!r.ok) throw new Error('SimplyTranslate ' + r.status);
      const d = await r.json();
      return { text: d.result, src: d.from || detectLangLocal(text), provider: 'simplytranslate' };
    }

    const _TR_FN = { google: _trGoogle, proxy: _trProxy, simplytranslate: _trSimply };

    async function translateText(text, tl, direction) {
      direction = direction || 'receive';
      const prov = cfg('provider', 'google');
      const styleKey = direction === 'send' ? 'sendStylePreset' : 'stylePreset';
      const ctxKey = prov === 'proxy'
        ? (direction + '|' + cfg(styleKey, 'default') + '|' + buildContext().slice(-40))
        : '';
      const key = prov + '|' + tl + '|' + ctxKey + '|' + text;
      if (transCache.has(key)) return transCache.get(key);
      if (inFlight.has(key)) return inFlight.get(key);
      const p = (async function () {
        const fn = _TR_FN[prov];
        if (!fn) throw new Error('Unknown provider: ' + prov);
        const out = await fn(text, tl, direction);
        if (!out || !out.text) throw new Error('Empty translation');
        transCache.set(key, out);
        if (transCache.size > 800) transCache.delete(transCache.keys().next().value);
        return out;
      })().finally(function () { inFlight.delete(key); });
      inFlight.set(key, p);
      return p;
    }
    function pickTarget(text, mode) {
      if (mode !== 'auto') return mode;
      const hasJa = /[\u3040-\u309f\u30a0-\u30ff\u4e00-\u9faf]/.test(text);
      return hasJa ? 'en' : 'ja';
    }
    function detectLangLocal(text) {
      if (/[\u3040-\u309f\u30a0-\u30ff]/.test(text)) return 'ja';
      if (/[\u4e00-\u9faf]/.test(text)) return 'zh';
      if (/[\uac00-\ud7af]/.test(text)) return 'ko';
      if (/[\u0400-\u04ff]/.test(text)) return 'ru';
      if (/[\u0600-\u06ff]/.test(text)) return 'ar';
      if (/[\u0e00-\u0e7f]/.test(text)) return 'th';
      if (/[\u0900-\u097f]/.test(text)) return 'hi';
      return 'en';
    }
    function langName(c) { return LANG_NATIVE[c] || c; }

    /* ---- System message filter ---- */
    const SYS_RE = new RegExp([
      'joined the game','left the game','has joined','has left',
      'logged in','logged out','connected','disconnected',
      '退出しました','参加しました','入室しました','退室しました',
      'ログインしました','ログアウトしました',
      'が退出','が参加','が入室','が退室','が入りました','が出ました',
      'ゲームに参加','ゲームから退出',
      '加入了游戏','离开了游戏','已加入','已退出','已离开',
      '加入游戏','离开游戏','进入游戏','退出游戏',
      '참가했습니다','퇴장했습니다','입장했습니다'
    ].join('|'), 'i');
    function isSystemMessage(sender, text, full) {
      if (!cfg('skipSystemMessages', true)) return false;
      if (!sender) return true;
      if (SYS_RE.test(text) || SYS_RE.test(full)) return true;
      return false;
    }

    /* ---- Chat input finder ---- */
    function findChatInput() {
      const sels = ['input.input.active-input', 'input.input', 'input[placeholder="入力..."]', 'textarea'];
      for (let i = 0; i < sels.length; i++) {
        const list = document.querySelectorAll(sels[i]);
        for (let j = 0; j < list.length; j++) {
          const el = list[j];
          if (el.offsetParent !== null || el === document.activeElement) return el;
        }
      }
      return null;
    }

    /* ---- State ---- */
    const st = {
      attached: false,
      observer: null,
      messageDataAttribute: null,
      inputState: 0,
      boardData: [],
      listEl: null,
      boardWrap: null,
      lastStore: null,
      themeTimer: 0
    };

    /* ---- Inline translation ---- */
    function ensureInline(el, translated, srcLang) {
      el.querySelectorAll('.ac-ct-inline').forEach(function (n) { n.remove(); });
      if (!cfg('inlineEnabled', true) || !translated) return;
      const wrap = document.createElement('div');
      wrap.className = 'ac-ct-inline';
      const tag = (cfg('showLangTag', true) && srcLang)
        ? '<span class="ac-ct-tag">' + escapeHtml(LANG_SHORT[srcLang] || String(srcLang).toUpperCase().slice(0, 2)) + '</span>'
        : '';
      wrap.innerHTML = tag + escapeHtml(translated);
      const bc = cfg('inlineBorderColor', '');
      if (bc) wrap.style.borderLeftColor = bc;
      const tc = cfg('inlineTextColor', '');
      if (tc) wrap.style.color = tc;
      const fs = Number(cfg('inlineFontSize', 12)) || 12;
      wrap.style.fontSize = fs + 'px';
      el.appendChild(wrap);
    }

    /* ---- Message parsing ---- */
    function extractOriginalText(el) {
      if (el.dataset.acCtOrig) return el.dataset.acCtOrig;
      const clone = el.cloneNode(true);
      clone.querySelectorAll('.ac-ct-inline').forEach(function (n) { n.remove(); });
      return String(clone.innerText || clone.textContent || '').replace(/\s+/g, ' ').trim();
    }
    function parseMessage(el) {
      if (!el) return null;
      const full = extractOriginalText(el);
      if (!full) return null;
      const colonIdx = full.indexOf(':');
      let sender = '', text = full;
      if (colonIdx >= 0 && colonIdx < 30) {
        sender = full.slice(0, colonIdx).replace(/^[\s★⭐]+/, '').trim();
        text = full.slice(colonIdx + 1).trim();
      }
      let hasRole = false;
      el.querySelectorAll('img').forEach(function (img) {
        const src = img.src || '';
        if (/Verify|Youtuber|Mod|Vanguard|Streamer/i.test(src) || img.classList.contains('icon-img')) hasRole = true;
      });
      return { sender: sender, text: text, full: full, hasRole: hasRole, el: el };
    }
    function isBadMessage(text) {
      if (text.length > 300) return true;
      if ((text.match(/\n/g) || []).length >= 3) return true;
      if (/(^|\n)[^\s:]{2,20}[ \t]*:[^\n]{1,200}\n[^\s:]{2,20}[ \t]*:/.test(text)) return true;
      return false;
    }

    /* ---- Process message ---- */
    async function processMessage(el) {
      if (!el || el.nodeType !== 1) return;
      if (el.dataset.acCtDone === 'true') {
        if (cfg('inlineEnabled', true) && !el.querySelector('.ac-ct-inline') && el.dataset.acCtTrans) {
          ensureInline(el, el.dataset.acCtTrans, el.dataset.acCtSrc);
        }
        return;
      }
          const p = parseMessage(el);
      if (!p) return;
      if (isBadMessage(p.text)) { el.dataset.acCtDone = 'true'; return; }

      // ★ システムメッセージ: コンテキストにも入れず、翻訳もしない
      if (isSystemMessage(p.sender, p.text, p.full)) {
        el.dataset.acCtDone = 'true';
        return;
      }

      // ★ コンテキストに追加
      addToContext(p.sender, p.text);

      el.dataset.acCtOrig = p.text;
      const targetLang = pickTarget(p.text, cfg('receiveMode', 'auto'));
      const detected = detectLangLocal(p.text);
      const sender = (p.hasRole ? '[★] ' : '') + p.sender;
      if (detected === targetLang) {
        el.dataset.acCtDone = 'true';
        if (cfg('boardEnabled', true)) addToBoard(sender, p.text, p.text, langName(detected), true);
        return;
      }
      el.dataset.acCtDone = 'processing';
      try {
        const r = await translateText(p.text, targetLang, 'receive');
        if (!r.text || !r.text.trim()) { el.dataset.acCtDone = 'true'; return; }
        el.dataset.acCtTrans = r.text;
        el.dataset.acCtSrc = r.src;
        el.dataset.acCtDone = 'true';
        ensureInline(el, r.text, r.src);
        if (cfg('boardEnabled', true)) addToBoard(sender, p.text, r.text, langName(r.src), r.src === targetLang);
      } catch (err) {
        el.dataset.acCtDone = 'true';
        console.error('[ChatTranslator] receive failed:', err);
      }
    }

    /* ---- Message attribute detection ---- */
    function detectMessageAttribute() {
      try {
        const css = [].slice.call(document.styleSheets).find(function (x) { return x && x.href && x.href.indexOf('assets/Game-') >= 0; });
        if (!css) return false;
        const rules = [].slice.call(css.cssRules);
        const m = rules.find(function (x) { return x && x.selectorText && x.selectorText.indexOf('.messages[data-v-') >= 0; });
        if (!m) return false;
        const r = m.selectorText.match(/\.messages\[(data-v-[^\]]+)\]/);
        if (!r) return false;
        if (r[1] !== st.messageDataAttribute) {
          st.messageDataAttribute = r[1];
          log('message attribute:', st.messageDataAttribute);
          startObserver();
        }
        return true;
      } catch (e) { return false; }
    }
    function startObserver() {
      if (st.observer) st.observer.disconnect();
      if (!document.body || !st.messageDataAttribute) return;
      st.observer = new MutationObserver(function (mutations) {
        mutations.forEach(function (m) {
          m.addedNodes.forEach(function (node) {
            if (node.nodeType !== 1 || !st.messageDataAttribute) return;
            if (node.hasAttribute && node.hasAttribute(st.messageDataAttribute)) processMessage(node);
            if (node.querySelectorAll) {
              node.querySelectorAll('.messages[' + st.messageDataAttribute + ']').forEach(processMessage);
            }
          });
        });
      });
      st.observer.observe(document.body, { childList: true, subtree: true });
      document.querySelectorAll('.messages[' + st.messageDataAttribute + ']').forEach(processMessage);
    }
    function stopObserver() {
      if (st.observer) { try { st.observer.disconnect(); } catch (_) {} st.observer = null; }
    }

    /* ---- Board data ---- */
    function addToBoard(sender, original, translated, langNameStr, isSameLang) {
      st.boardData.push({ sender: sender, original: original, translated: translated, langName: langNameStr, isSameLang: isSameLang, time: Date.now() });
      const max = Math.max(10, Math.min(200, Number(cfg('historyMax', 50)) || 50));
      while (st.boardData.length > max) st.boardData.shift();
      renderBoardItem(st.boardData[st.boardData.length - 1]);
    }
    function buildItemHTML(item) {
      const senderHTML = item.sender ? '<div class="ac-ct-sender">' + escapeHtml(item.sender) + '</div>' : '';
      const langTag = (cfg('showLangTag', true) && item.langName) ? '<span class="ac-ct-tag">' + escapeHtml(item.langName) + '</span> ' : '';
      if (item.isSameLang) return senderHTML + '<div class="ac-ct-trans">' + langTag + escapeHtml(item.original) + '</div>';
      const origHTML = cfg('showOriginalOnBoard', true) ? '<div class="ac-ct-orig">' + escapeHtml(item.original) + '</div>' : '';
      return senderHTML + origHTML + '<div class="ac-ct-trans">' + langTag + escapeHtml(item.translated) + '</div>';
    }
    function renderBoardItem(item) {
      if (!st.listEl) return;
      const div = document.createElement('div');
      div.className = 'ac-ct-item';
      div.innerHTML = buildItemHTML(item);
      st.listEl.appendChild(div);
      const max = Math.max(10, Math.min(200, Number(cfg('historyMax', 50)) || 50));
      while (st.listEl.children.length > max) st.listEl.removeChild(st.listEl.firstChild);
      st.listEl.scrollTop = st.listEl.scrollHeight;
    }
    function renderBoardAll() {
      if (!st.listEl) return;
      st.listEl.innerHTML = '';
      st.boardData.forEach(function (item) {
        const div = document.createElement('div');
        div.className = 'ac-ct-item';
        div.innerHTML = buildItemHTML(item);
        st.listEl.appendChild(div);
      });
      st.listEl.scrollTop = st.listEl.scrollHeight;
    }
    function clearBoard() { st.boardData.length = 0; if (st.listEl) st.listEl.innerHTML = ''; }

    /* ---- Retranslate all ---- */
    async function retranslateAll() {
      log('retranslate all');
      const attr = st.messageDataAttribute;
      const msgNodes = attr ? [].slice.call(document.querySelectorAll('.messages[' + attr + ']')) : [];
      for (let i = 0; i < msgNodes.length; i++) {
        const el = msgNodes[i];
        const p = parseMessage(el);
        if (!p || !p.text) continue;
        if (isSystemMessage(p.sender, p.text, p.full)) continue;
        const targetLang = pickTarget(p.text, cfg('receiveMode', 'auto'));
        const detected = detectLangLocal(p.text);
        if (detected === targetLang) {
          el.querySelectorAll('.ac-ct-inline').forEach(function (n) { n.remove(); });
          el.dataset.acCtDone = 'true';
          el.dataset.acCtTrans = '';
          el.dataset.acCtSrc = detected;
          continue;
        }
        try {
          const r = await translateText(p.text, targetLang);
          if (r.text && r.text.trim()) {
            el.dataset.acCtTrans = r.text;
            el.dataset.acCtSrc = r.src;
            el.dataset.acCtDone = 'true';
            ensureInline(el, r.text, r.src);
          }
        } catch (e) {}
      }
      st.boardData.length = 0;
      if (st.listEl) st.listEl.innerHTML = '';
      for (let i = 0; i < msgNodes.length; i++) {
        const el = msgNodes[i];
        const p = parseMessage(el);
        if (!p || !p.text) continue;
        if (isSystemMessage(p.sender, p.text, p.full)) continue;
        const sender = (p.hasRole ? '[★] ' : '') + p.sender;
        const detected = detectLangLocal(p.text);
        const targetLang = pickTarget(p.text, cfg('receiveMode', 'auto'));
        if (detected === targetLang) {
          addToBoard(sender, p.text, p.text, langName(detected), true);
        } else if (el.dataset.acCtTrans) {
          addToBoard(sender, p.text, el.dataset.acCtTrans, langName(el.dataset.acCtSrc), false);
        }
      }
    }

    /* ---- Send hook ---- */
    async function onSendKeyDown(e) {
      if (!st.attached) return;
      if (e.key !== 'Enter') return;
      if (e.isComposing || e.keyCode === 229) return;
      const input = findChatInput();
      if (!input || e.target !== input) return;
      if (st.inputState !== 0) { e.preventDefault(); e.stopImmediatePropagation(); return; }
      if (!cfg('inputEnabled', true)) return;
      const original = (input.value || '').trim();
      if (!original) return;
      const prefixes = ['/', '!'];
      for (let i = 0; i < prefixes.length; i++) if (original.indexOf(prefixes[i]) === 0) return;
   　　e.preventDefault(); e.stopImmediatePropagation();
      st.inputState = 1;
      addToContext('You', original);   // ★ 自分の発言もコンテキストへ
      log('send translate:', original);
      let translated = original;
      try {
        const tl = pickTarget(original, cfg('inputMode', 'auto'));
        const r = await translateText(original, tl, 'send');
        translated = r.text.replace(/\n+/g, ' ').trim();
        log('send result:', translated, '(->', tl + ')');
      } catch (err) { console.error('[ChatTranslator] send failed:', err); }
      if (!translated) translated = original;
      input.value = translated;
      input.dispatchEvent(new Event('input', { bubbles: true }));
      st.inputState = 2;
      const opts = { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true, cancelable: true };
      input.dispatchEvent(new KeyboardEvent('keydown', opts));

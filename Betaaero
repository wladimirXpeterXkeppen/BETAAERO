  /* ============================================================
     MOD: GUI Theme
     ============================================================ */
  const GUI_THEME_CSS = {
    default: '',
    aero: AERO_THEME_CSS,
    moon: MOON_THEME_CSS
  };

  Mods.reg({
    id: 'guittheme',
    name: 'GUI Theme',
    category: 'Visual',
    icon: 'svg:palette',
    description: 'GUI skin selector — Default / Aero / Moon',
    defaultEnabled: true,
    settings: [
      {
        id: 'theme',
        type: 'dropdown',
        label: 'Theme',
        options: [
          { value: 'default', label: 'Default' },
          { value: 'aero',    label: 'Aero' },
          { value: 'moon',    label: 'Moon' }
        ],
        default: 'aero'
      }
    ],
    init() {
      this._styleEl = null;
      this._current = null;
      if (Mods.on('guittheme')) this._apply();
    },
    _apply() {
      const themeId = Mods.gs('guittheme', 'theme', 'aero');
      if (this._current === themeId && this._styleEl && this._styleEl.isConnected) return;
      this._remove();
      const css = GUI_THEME_CSS[themeId];
      if (!css) { this._current = themeId; return; }
      this._styleEl = document.createElement('style');
      this._styleEl.id = 'ac-theme-' + themeId;
      this._styleEl.textContent = css;
      document.head.appendChild(this._styleEl);
      this._current = themeId;
    },
    _remove() {
      if (this._styleEl) { try { this._styleEl.remove(); } catch (_) {} this._styleEl = null; }
      this._current = null;
    },
    apply(enabled) {
      if (enabled) this._apply();
      else this._remove();
    },
    destroy() { this._remove(); }
  });

  /* ===== MOD: FPS Counter ===== */
  Mods.reg({
    id: 'fps', name: 'FPS Counter', category: 'HUD', icon: 'svg:gauge', description: 'Frame rate display', defaultEnabled: true, settings: [],
    init() {
      const st = this;
      st._el = null; st._value = 0; st._frames = 0; st._last = 0; st._raf = 0; st._running = false;
      const loop = now => {
        if (!Mods.on('fps')) { st._raf = 0; st._running = false; return; }
        st._raf = requestAnimationFrame(loop);
        st._frames++;
        if (now - st._last >= 1000) {
          st._value = Math.round(st._frames * 1000 / (now - st._last));
          st._frames = 0; st._last = now;
          if (st._el) { const v = st._el.querySelector('.fps-value'); if (v && v.textContent !== String(st._value)) v.textContent = st._value; }
        }
      };
      st._start = () => { if (st._running) return; st._running = true; st._last = performance.now(); st._frames = 0; st._raf = requestAnimationFrame(loop); };
      st._stop = () => { if (st._raf) { cancelAnimationFrame(st._raf); st._raf = 0; } st._running = false; };
      st._inject = setInterval(() => {
        if (!Mods.on('fps')) { if (st._el) { st._el.remove(); st._el = null; } return; }
        const stats = document.querySelector('.chat .stats');
        if (!stats) return;
        if (stats.querySelector('.ac-hud-fps')) { st._el = stats.querySelector('.ac-hud-fps'); return; }
        const el = document.createElement('div');
        el.className = 'ac-hud-fps';
        el.innerHTML = '<span class="coord-symbol">FPS</span><span class="fps-value">0</span>';
        el.querySelector('.fps-value').textContent = st._value;
        stats.appendChild(el);
        st._el = el;
      }, 400);
      st._start();
    },
    apply(enabled) { if (enabled) this._start && this._start(); else this._stop && this._stop(); },
    destroy() { this._stop && this._stop(); clearInterval(this._inject); if (this._el) this._el.remove(); }
  });

  /* ===== MOD: CPS Counter ===== */
  Mods.reg({
    id: 'cps', name: 'CPS Counter', category: 'HUD', icon: 'svg:mouseClick', description: 'Click per second', defaultEnabled: true, settings: [],
    init() {
      const st = this;
      st._el = null;
      st._loop = setInterval(() => {
        if (!Mods.on('cps')) return;
        if (!st._el) return;
        const cps = Input.cpsNow();
        const v = st._el.querySelector('.cps-value');
        const nv = String(cps.left);
        if (v && v.textContent !== nv) v.textContent = nv;
        Input.prune();
      }, 100);
      st._inject = setInterval(() => {
        if (!Mods.on('cps')) { if (st._el) { st._el.remove(); st._el = null; } return; }
        const stats = document.querySelector('.chat .stats');
        if (!stats) return;
        if (stats.querySelector('.ac-hud-cps')) { st._el = stats.querySelector('.ac-hud-cps'); return; }
        const el = document.createElement('div');
        el.className = 'ac-hud-cps';
        el.innerHTML = '<span class="coord-symbol">CPS</span><span class="cps-value">0</span>';
        stats.appendChild(el);
        st._el = el;
      }, 400);
    },
    apply() {},
    destroy() { clearInterval(this._loop); clearInterval(this._inject); if (this._el) this._el.remove(); }
  });

  /* ===== MOD: Ping Counter ===== */
  Mods.reg({
    id: 'ping', name: 'Ping Counter', category: 'HUD', icon: 'svg:signal', description: 'Network latency', defaultEnabled: true,
    settings: [
      { id: 'pingInterval', type: 'slider', label: 'Probe interval (ms)', min: 1000, max: 10000, step: 500, default: 3000 },
      { id: 'goodThreshold', type: 'slider', label: 'Good (ms)', min: 20, max: 300, step: 10, default: 60 },
      { id: 'midThreshold', type: 'slider', label: 'Mid (ms)', min: 50, max: 500, step: 10, default: 150 }
    ],
    init() {
      const st = this;
      st._el = null; st._good = 60; st._mid = 150;
      const refresh = () => { const s = Config.get('mods.ping') || {}; st._good = s.goodThreshold || 60; st._mid = s.midThreshold || 150; };
      refresh();
      const render = ms => {
        if (!st._el) return;
        const v = st._el.querySelector('.ping-value');
        if (v) v.textContent = ms;
        st._el.classList.remove('good', 'mid', 'bad');
        if (ms < st._good) st._el.classList.add('good');
        else if (ms < st._mid) st._el.classList.add('mid');
        else st._el.classList.add('bad');
      };
      st._render = render;
      if (!window.__acPingHooked) {
        window.__acPingHooked = true;
        const OrigWS = window.WebSocket;
        const HookedWS = function(url, protos) {
          const ws = protos ? new OrigWS(url, protos) : new OrigWS(url);
          const oS = ws.send.bind(ws);
          ws.send = function(data) {
            try { const m = typeof data === 'string' ? JSON.parse(data) : null; if (m && /ping/i.test(m.type) && typeof m.time === 'number') ws.__acLP = m.time; } catch (_) {}
            return oS(data);
          };
          ws.addEventListener('message', ev => {
            try {
              const m = JSON.parse(ev.data);
              if (m && /pong/i.test(m.type) && typeof m.time === 'number' && ws.__acLP) { render(Math.max(0, Date.now() - ws.__acLP)); ws.__acLP = null; }
            } catch (_) {}
          });
          return ws;
        };
        HookedWS.prototype = OrigWS.prototype;
        HookedWS.CONNECTING = OrigWS.CONNECTING;
        HookedWS.OPEN = OrigWS.OPEN;
        HookedWS.CLOSING = OrigWS.CLOSING;
        HookedWS.CLOSED = OrigWS.CLOSED;
        window.WebSocket = HookedWS;
      }
      const probe = async () => {
        if (!Mods.on('ping')) return;
        const t0 = performance.now();
        try { await fetch(location.origin + '/favicon.ico?_=' + Date.now(), { method: 'HEAD', cache: 'no-store', mode: 'no-cors' }); render(Math.round(performance.now() - t0)); } catch (_) {}
      };
      st._startProbe = () => {
        if (st._probeId) clearInterval(st._probeId);
        refresh();
        const iv = (Config.get('mods.ping') || {}).pingInterval || 3000;
        st._probeId = setInterval(() => { if (Mods.on('ping')) probe(); }, iv);
        probe();
      };
      st._startProbe();
      st._inject = setInterval(() => {
        if (!Mods.on('ping')) { if (st._el) { st._el.remove(); st._el = null; } return; }
        const stats = document.querySelector('.chat .stats');
        if (!stats) return;
        if (stats.querySelector('.ac-hud-ping')) { st._el = stats.querySelector('.ac-hud-ping'); return; }
        const el = document.createElement('div');
        el.className = 'ac-hud-ping';
        el.innerHTML = '<span class="coord-symbol">PING</span><span class="ping-value">0</span>';
        stats.appendChild(el);
        st._el = el;
      }, 400);
    },
    apply(enabled) { if (enabled && this._startProbe) this._startProbe(); },
    destroy() { clearInterval(this._inject); if (this._probeId) clearInterval(this._probeId); if (this._el) this._el.remove(); }
  });

  /* ===== MOD: Compass Rose ===== */
  Mods.reg({

    },
    apply(enabled, store) {
      const st = this;
      st._refreshCfg && st._refreshCfg();
      if (!enabled) {
        st._webgl(0); st._effects(0); st._timer(0); st._console(false);
        st._stopAdaptive && st._stopAdaptive();
        return;
      }
      const P = {
        adaptive: { webgl: 2, effects: 1, timerGuard: 0, consoleMute: false },
        balanced: { webgl: 1, effects: 1, timerGuard: 0, consoleMute: false },
        performance: { webgl: 2, effects: 2, timerGuard: 0, consoleMute: false },
        ultra: { webgl: 3, effects: 3, timerGuard: 1, consoleMute: true }
      };
      const p = P[store.fpsMode] || P.performance;
      st._webgl(store.fpsMode === 'adaptive' ? store.webgl : (store.webgl == null ? p.webgl : store.webgl));
      st._effects(store.fpsMode === 'adaptive' ? store.effects : (store.effects == null ? p.effects : store.effects));
      st._timer(store.timerGuard == null ? p.timerGuard : store.timerGuard);
      st._console(store.consoleMute == null ? p.consoleMute : store.consoleMute);
      if (store.cameraEnabled) st._setCameraFar(store.cameraFar || 40);
      if (store.fpsMode === 'adaptive') st._startAdaptive && st._startAdaptive();
      else st._stopAdaptive && st._stopAdaptive();
    },
    destroy() { const st = this; st._stopAdaptive && st._stopAdaptive(); st.apply(false, {}); clearInterval(st._camLoop); }
  });


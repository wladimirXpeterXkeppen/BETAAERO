    /* ---- Tick loop ---- */
    function tick() {
      if (!state.running) return;
      state.rafId = requestAnimationFrame(tick);
      const inGame = isInGame() || isEditingHud();
      if (inGame && !state.wasInGame) resetStats();
      state.wasInGame = inGame;
      if (!inGame) return;
      const gw = Game.world();
      if (!gw || !gw.player) { state.lastPos = null; return; }
      const p = gw.player.position;
      if (!p || typeof p.x !== 'number') return;
      const now = performance.now();
      if (state.lastPos) {
        const dtMs = now - state.lastTime;
        if (dtMs > 0 && dtMs < 500) {
          const dt = dtMs / 1000;
          const dx = p.x - state.lastPos.x;
          const dy = p.y - state.lastPos.y;
          const dz = p.z - state.lastPos.z;
          const hSpeed = Math.sqrt(dx * dx + dz * dz) / dt;
          const vSpeed = Math.abs(dy) / dt;
          const tSpeed = Math.sqrt(dx * dx + dy * dy + dz * dz) / dt;
          let fSpeed = 0;
          try {
            const rot = gw.player.rotation;
            const yaw = (typeof rot === 'number') ? rot
                      : (rot && typeof rot.y === 'number') ? rot.y : 0;
            const fx = Math.sin(yaw);
            const fz = Math.cos(yaw);
            fSpeed = (dx * fx + dz * fz) / dt;
          } catch (_) { fSpeed = hSpeed; }
          const mode = Mods.gs('speedometer', 'mode', 'horizontal');
          let primary;
          switch (mode) {
            case 'vertical': primary = vSpeed; break;
            case 'total':    primary = tSpeed; break;
            case 'forward':  primary = fSpeed; break;
            case 'all':      primary = hSpeed; break;
            default:         primary = hSpeed; break;
          }
          state.speed = state.speed + (primary - state.speed) * SMOOTH;
          if (state.speed > state.maxSpeed) state.maxSpeed = state.speed;
          if (mode === 'all') {
            state.vSpeed = state.vSpeed + (vSpeed - state.vSpeed) * SMOOTH;
          }
          state.history.push({ t: now, h: hSpeed, v: vSpeed, total: tSpeed });
          while (state.history.length > HIST_MAX) state.history.shift();
        }
      }
      state.lastPos = { x: p.x, y: p.y, z: p.z };
      state.lastTime = now;
      updateHud();
    }

    /* ---- HUD update ---- */
    function unitFactor(u) {
      if (u === 'kmh') return 3.6;
      if (u === 'mph') return 2.23694;
      return 1;
    }
    function unitLabel(u) {
      if (u === 'kmh') return 'km/h';
      if (u === 'mph') return 'mph';
      if (u === 'ms')  return 'm/s';
      return 'b/s';
    }
    function updateHud() {
      const el = state.hudEl;
      if (!el) return;
      const theme    = Mods.gs('speedometer', 'theme', 'default');
      const mode     = Mods.gs('speedometer', 'mode', 'horizontal');
      const unit     = Mods.gs('speedometer', 'unit', 'bs');
      const decimals = Mods.gs('speedometer', 'decimals', 2);
      const barMax   = Mods.gs('speedometer', 'barMax', 15) || 15;
      const showGraph= Mods.gs('speedometer', 'showGraph', false);
      const f = unitFactor(unit);
      if (theme === 'rainbow') {
        state.rainbowHue = (state.rainbowHue + 1.2) % 360;
        const s = el.querySelector('.ac-spd');
        if (s) {
          const col = 'hsl(' + state.rainbowHue + ',100%,65%)';
          s.style.setProperty('--spd-border', col);
          s.style.setProperty('--spd-label-color', col);
          s.style.setProperty('--spd-unit-color', col);
          s.style.setProperty('--spd-extra-color', col);
          s.style.setProperty('--spd-graph-color', col);
        }
      }
      const numEl  = el.querySelector('.spd-num');
      const unitEl = el.querySelector('.spd-unit');
      const maxEl  = el.querySelector('.spd-max');
      const avgEl  = el.querySelector('.spd-avg');
      const fillEl = el.querySelector('.spd-bar-fill');
      const vertEl = el.querySelector('.spd-vert');
      if (numEl)  numEl.textContent  = (state.speed * f).toFixed(decimals);
      if (unitEl) unitEl.textContent = unitLabel(unit);
      if (vertEl) {
        if (mode === 'all') {
          vertEl.style.display = '';
          vertEl.textContent = 'H ' + (state.speed * f).toFixed(decimals) +
                               '  V ' + (state.vSpeed * f).toFixed(decimals);
        } else {
          vertEl.style.display = 'none';
        }
      }
      if (maxEl) maxEl.textContent = 'max ' + (state.maxSpeed * f).toFixed(decimals);
      if (avgEl) {
        if (!state.history.length) {
          avgEl.textContent = 'avg 0.' + '0'.repeat(decimals);
        } else {
          let sum = 0;
          for (let i = 0; i < state.history.length; i++) {
            const h = state.history[i];
            if (mode === 'vertical')      sum += h.v;
            else if (mode === 'total')    sum += h.total;
            else                          sum += h.h;
          }
          avgEl.textContent = 'avg ' + ((sum / state.history.length) * f).toFixed(decimals);
        }
      }
      if (fillEl) {
        const pct = Math.max(0, Math.min(100, (state.speed / barMax) * 100));
        fillEl.style.width = pct + '%';
        let col;
        if (pct < 33) col = '#22c55e';
        else if (pct < 66) col = '#eab308';
        else col = '#ef4444';
        fillEl.style.background = col;
      }
      if (showGraph) {
        const g = el.querySelector('.spd-graph');
        if (g) {
          const s2 = el.querySelector('.ac-spd');
          const graphColor = theme === 'rainbow'
            ? 'hsl(' + state.rainbowHue + ',100%,65%)'
            : (getComputedStyle(s2).getPropertyValue('--spd-graph-color') || '#3b82f6').trim();
          drawGraph(g, mode, graphColor);
        }
      }
    }


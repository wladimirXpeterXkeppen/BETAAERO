    /* ---- Keybind wrapper + toggle toast ---- */
    function attachKeybind(mod, defaultKey) {
      mod.settings = mod.settings || [];
      if (!mod.settings.some(function (s) { return s.id === 'keybind'; })) {
        mod.settings.unshift({
          id: 'keybind', type: 'keybind',
          label: 'Toggle key', default: defaultKey || 'None'
        });
      }
      let handler = null;
      function onKeyDown(e) {
        if (e.repeat) return;
        if (isGuiOpen()) return;
        if (isTypingContext(e)) return;
        const k = Mods.gs(mod.id, 'keybind', defaultKey || 'None');
        if (!k || k === 'None' || k === 'Escape') return;
        if (e.code !== k) return;
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            if (isGuiOpen()) return;
            if (isTypingContext(null)) return;
            Mods.toggle(mod.id);
          });
        });
      }
      function start() { if (!handler) { handler = onKeyDown; window.addEventListener('keydown', handler, true); } }
      function stop()  { if (handler) { window.removeEventListener('keydown', handler, true); handler = null; } }
      const oA = mod.apply   ? mod.apply.bind(mod)   : function () {};
      const oI = mod.init    ? mod.init.bind(mod)    : function () {};
      const oD = mod.destroy ? mod.destroy.bind(mod) : function () {};
      let lastEn = null;
      mod.apply = function (en, st) {
        oA(en, st); start();
        if (lastEn !== null && lastEn !== en) showToast(mod.name, en);
        lastEn = en;
      };
      mod.init    = function () { oI(); start(); };
      mod.destroy = function () { stop(); oD(); };
      return mod;
    }


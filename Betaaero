        st._adaptiveRaf = requestAnimationFrame(adaptiveLoop);
      };
      st._stopAdaptive = () => {
        if (st._adaptiveRaf) { cancelAnimationFrame(st._adaptiveRaf); st._adaptiveRaf = 0; }
        st._adaptiveRunning = false;
      };
      st._camLoop = setInterval(() => {
        const s = st._cfg;
        if (!s || !Mods.on('fpsbooster') || !s.cameraEnabled) return;
        const gw = Game.world(); if (!gw || !gw.threeScene) return;
        const cam = gw.threeScene.foregrCamera; if (!cam) return;
        if (Math.abs(cam.far - (s.cameraFar || 40)) > 1) st._setCameraFar(s.cameraFar || 40);

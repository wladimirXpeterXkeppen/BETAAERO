`;

  /* ===== Confirm ===== */
  const Confirm = (() => {
    let modal = null;
    function open(o) {
      close();
      const mask = ce('div', 'ac-modal-mask');
      document.body.appendChild(mask);
      const box = ce('div', 'ac-confirm', mask);
      const h = ce('h3', '', box); h.textContent = o.title || 'Confirm';
      const p = ce('p', '', box); p.textContent = o.message || '';
      const btns = ce('div', 'ac-confirm-btns', box);
      const c = ce('button', 'cancel', btns); c.textContent = o.cancelText || 'Cancel';
      const ok = ce('button', o.danger ? 'danger' : 'ok', btns); ok.textContent = o.okText || 'OK';
      c.onclick = () => { close(); o.onCancel && o.onCancel(); };
      ok.onclick = () => { close(); o.onOk && o.onOk(); };
      mask.onclick = e => { if (e.target === mask) { close(); o.onCancel && o.onCancel(); } };
      modal = { mask };
    }
    function close() { if (modal) { modal.mask.remove(); modal = null; } }
    return { open, close };
  })();

  /* ===== PixelEditor (v32.2: paint fix + center crosshair) ===== */
  const PixelEditor = (() => {
    let modal = null, state = null, onSave = null;
    function build() {
      const mask = ce('div', 'ac-modal-mask');
      document.body.appendChild(mask);
      mask.onclick = e => { if (e.target === mask) close(); };
      const box = ce('div', 'ac-modal', mask);
      box.style.width = 'min(360px,92vw)';
      const cb = ce('button', 'ac-modal-close', box); cb.textContent = '✕'; cb.onclick = () => close();
      const h = ce('h3', '', box); h.textContent = 'Pixel Editor';
      const info = ce('div', 'sub', box);
      info.textContent = (state.targetLabel || '') + '  ' + state.n + 'x' + state.n;

      // Wrapper so we can overlay the center crosshair without touching grid children
      const gridWrap = ce('div', 'ac-pe-wrap', box);
      const gridEl = ce('div', 'ac-pe-grid', gridWrap);
      gridEl.style.gridTemplateColumns = 'repeat(' + state.n + ',1fr)';
      const crossEl = ce('div', 'ac-pe-cross', gridWrap);
      void crossEl; // purely decorative

      const tabs = ce('div', 'ac-pe-tabs', box);
      const tabP = ce('button', 'ac-pe-tab active', tabs); tabP.textContent = 'Palette';
      const tabC = ce('button', 'ac-pe-tab', tabs); tabC.textContent = 'Custom';
      const paneP = ce('div', '', box); paneP.style.cssText = 'margin-top:8px;';
      const paneC = ce('div', '', box); paneC.style.cssText = 'margin-top:8px;display:none;';
      tabP.onclick = () => { tabP.classList.add('active'); tabC.classList.remove('active'); paneP.style.display = 'block'; paneC.style.display = 'none'; };
      tabC.onclick = () => { tabC.classList.add('active'); tabP.classList.remove('active'); paneP.style.display = 'none'; paneC.style.display = 'block'; };
      const pH = ce('div', '', paneP);
      pH.style.cssText = 'display:flex;align-items:center;gap:6px;margin-bottom:6px;font-size:10px;color:#8a8d96;';
      pH.innerHTML = '<span>Detail</span>';
      const pD = ce('input', '', pH);
      pD.type = 'range'; pD.min = '2'; pD.max = '6'; pD.step = '1'; pD.value = state.paletteDetail;
      pD.style.cssText = 'flex:1;accent-color:#3b82f6;';
      const pDV = ce('span', '', pH);
      pDV.textContent = state.paletteDetail;
      pDV.style.cssText = 'color:#3b82f6;font-weight:bold;min-width:14px;text-align:right;';
      const pal = ce('div', 'ac-pe-palette', paneP);
      const cR1 = ce('div', 'ac-pe-row', paneC); cR1.innerHTML = '<span>Base</span>';
      const cI = ce('input', '', cR1); cI.type = 'color'; cI.value = '#ffffff';
      const cR2 = ce('div', 'ac-pe-row', paneC); cR2.innerHTML = '<span>H</span>';
      const cH = ce('input', '', cR2); cH.type = 'range'; cH.min = '0'; cH.max = '360'; cH.step = '1';
      const cHV = ce('span', 'ac-pe-val', cR2); cHV.textContent = '0';
      const cR3 = ce('div', 'ac-pe-row', paneC); cR3.innerHTML = '<span>S</span>';
      const cS = ce('input', '', cR3); cS.type = 'range'; cS.min = '0'; cS.max = '100'; cS.step = '1';
      const cSV = ce('span', 'ac-pe-val', cR3); cSV.textContent = '0';
      const cR4 = ce('div', 'ac-pe-row', paneC); cR4.innerHTML = '<span>L</span>';
      const cL = ce('input', '', cR4); cL.type = 'range'; cL.min = '0'; cL.max = '100'; cL.step = '1';
      const cLV = ce('span', 'ac-pe-val', cR4); cLV.textContent = '100';
      const prevRow = ce('div', '', paneC);
      prevRow.style.cssText = 'display:flex;align-items:center;gap:8px;margin:8px 0;';
      const prevSw = ce('div', 'ac-pe-cur', prevRow);
      const prevHex = ce('span', '', prevRow);
      prevHex.style.cssText = 'font-family:monospace;font-size:11px;color:#e6e9ef;';
      prevHex.textContent = '#ffffff';
      const actRow = ce('div', '', paneC);
      actRow.style.cssText = 'display:flex;gap:6px;';
      const setBtn = ce('button', 'ac-btn secondary', actRow); setBtn.textContent = 'Set current'; setBtn.style.flex = '1';
      const addBtn = ce('button', 'ac-btn', actRow); addBtn.textContent = '+ Palette'; addBtn.style.flex = '1';
      const curRow = ce('div', '', box);
      curRow.style.cssText = 'display:flex;align-items:center;gap:6px;margin-top:10px;font-size:11px;color:#8a8d96;';
      curRow.innerHTML = '<span>Current:</span>';
      const curSw = ce('div', 'ac-pe-cur', curRow);
      const curHex = ce('span', '', curRow);
      curHex.style.cssText = 'font-family:monospace;color:#e6e9ef;font-size:11px;';
      curHex.textContent = 'transparent';
      const actions = ce('div', '', box);
      actions.style.cssText = 'display:flex;gap:6px;margin-top:12px;';
      const clr = ce('button', 'ac-btn secondary', actions); clr.textContent = 'Clear'; clr.style.flex = '1';
      const cancel = ce('button', 'ac-btn secondary', actions); cancel.textContent = 'Cancel'; cancel.style.flex = '1';
      const save = ce('button', 'ac-btn', actions); save.textContent = 'Save'; save.style.flex = '1';
      const n = state.n;
      state.grid = state.grid.slice();
      state.currentColor = '#ffffff';
      state.drawing = false;

      // v32.2: inline !important so themed stylesheet !important can't override us
      function cellBg(c, col) {
        if (col) c.style.setProperty('background', col, 'important');
        else c.style.removeProperty('background');
      }
      function buildGrid() {
        gridEl.innerHTML = '';
        for (let i = 0; i < n * n; i++) { const c = ce('div', 'ac-pe-cell', gridEl); c.dataset.idx = i; cellBg(c, state.grid[i]); }
      }
      buildGrid();
      function genPalette(det) {
        const arr = [null];
        for (let i = 0; i <= det; i++) { const l = Math.round((i / det) * 100); arr.push(hslToHex(0, 0, l)); }
        for (let hh = 0; hh < 12; hh++) for (let d = 0; d < det; d++) {
          const light = 25 + (d / Math.max(1, det - 1)) * 55;
          arr.push(hslToHex(hh * 30, 100, light));
        }
        state.customColors.forEach(c => arr.push(c));
        return arr;
      }
      let palette = genPalette(state.paletteDetail);
      function renderPalette() {
        pal.innerHTML = '';
        palette.forEach(c => {
          const sw = ce('div', 'ac-pe-swatch', pal);
          if (c === null) { sw.classList.add('transparent'); sw.dataset.color = ''; }
          else { sw.style.background = c; sw.dataset.color = c; }
          if (sameColor(c, state.currentColor)) sw.classList.add('selected');
          sw.onclick = () => {
            state.currentColor = c;
            updateCur();
            pal.querySelectorAll('.ac-pe-swatch').forEach(x => {
              const cc = x.dataset.color || null;
              if (sameColor(cc, c)) x.classList.add('selected'); else x.classList.remove('selected');
            });
          };
        });
      }
      function updateCur() {
        if (state.currentColor === null) { curSw.style.background = ''; curSw.classList.add('transparent'); curHex.textContent = 'transparent'; }
        else { curSw.style.background = state.currentColor; curSw.classList.remove('transparent'); curHex.textContent = state.currentColor; }
      }
      renderPalette(); updateCur();
      let rt = null;
      function schedule() { if (rt) return; rt = requestAnimationFrame(() => { rt = null; if (onSave) onSave(state.grid); }); }
      gridEl.addEventListener('mousedown', e => {
        e.preventDefault();
        if (!e.target.classList || !e.target.classList.contains('ac-pe-cell')) return;
        state.drawing = true;
        const idx = Number(e.target.dataset.idx);
        const col = (e.button === 2) ? null : state.currentColor;
        state.grid[idx] = col; cellBg(e.target, col); schedule();
      });
      gridEl.addEventListener('mouseover', e => {
        if (!state.drawing) return;
        if (!e.target.classList || !e.target.classList.contains('ac-pe-cell')) return;
        const idx = Number(e.target.dataset.idx);
        state.grid[idx] = state.currentColor; cellBg(e.target, state.currentColor); schedule();
      });
      gridEl.addEventListener('contextmenu', e => e.preventDefault());
      document.addEventListener('mouseup', () => { state.drawing = false; });
      pD.oninput = () => { state.paletteDetail = Number(pD.value); pDV.textContent = state.paletteDetail; palette = genPalette(state.paletteDetail); renderPalette(); };
      let ch = { h: 0, s: 0, l: 100 };
      function syncCustom(hex, skip) {
        const hsl = hexToHsl(hex);
        ch.h = hsl.h; ch.s = hsl.s; ch.l = hsl.l;
        cH.value = ch.h; cS.value = ch.s; cL.value = ch.l;
        cHV.textContent = ch.h; cSV.textContent = ch.s; cLV.textContent = ch.l;
        const hx = hslToHex(ch.h, ch.s, ch.l);
        if (!skip) cI.value = hx;
        prevSw.style.background = hx; prevHex.textContent = hx;
      }
      cI.oninput = () => syncCustom(cI.value, true);
      cH.oninput = () => syncCustom(hslToHex(Number(cH.value), ch.s, ch.l));
      cS.oninput = () => syncCustom(hslToHex(ch.h, Number(cS.value), ch.l));
      cL.oninput = () => syncCustom(hslToHex(ch.h, ch.s, Number(cL.value)));
      setBtn.onclick = () => {
        const c = hslToHex(ch.h, ch.s, ch.l);
        state.currentColor = c; updateCur();
        pal.querySelectorAll('.ac-pe-swatch').forEach(x => {
          const cc = x.dataset.color || null;
          if (sameColor(cc, c)) x.classList.add('selected'); else x.classList.remove('selected');
        });
      };
      addBtn.onclick = () => {
        const c = hslToHex(ch.h, ch.s, ch.l);
        if (!state.customColors.includes(c)) { state.customColors.push(c); palette = genPalette(state.paletteDetail); renderPalette(); }
        setBtn.click();
      };
      clr.onclick = () => { state.grid.fill(null); buildGrid(); schedule(); };
      cancel.onclick = () => close();
      save.onclick = () => close();
      modal = { mask };
    }
    function open(o) {
      state = { n: o.n, grid: o.grid.slice(), targetLabel: o.targetLabel, paletteDetail: o.paletteDetail || 3, customColors: (o.customColors || []).slice() };
      onSave = o.onChange;
      build();
    }
    function close() { if (!modal) return; modal.mask.remove(); modal = null; onSave = null; state = null; }
    return { open, close };
  })();

